PAKIT_ENVIRONMENT=local
PAKIT_DEBUG=false
PAKIT_API_PREFIX=/api
PAKIT_DATABASE_HOST=localhost
PAKIT_DATABASE_PORT=5432
PAKIT_DATABASE_NAME=pakit
PAKIT_DATABASE_USER=pakit
PAKIT_DATABASE_PASSWORD=
PAKIT_ADMIN_USERNAME=
PAKIT_ADMIN_PASSWORD=
# 실제 backend_usage_events 계측을 배포하는 시각 (예: 2026-08-20T18:00:00+09:00)
PAKIT_USAGE_TRACKING_STARTED_AT=
PAKIT_KAKAO_REST_API_KEY=
PAKIT_KAKAO_CLIENT_SECRET=
PAKIT_KAKAO_REDIRECT_URI=http://localhost:8000/api/auth/kakao/callback
PAKIT_FRONTEND_AUTH_REDIRECT_URL=http://localhost:3000
PAKIT_SESSION_SECRET=
# Pakit 로그인 유지 시간. 기본값 30일.
PAKIT_SESSION_MAX_AGE_SECONDS=2592000
POSTGRES_DB=pakit
POSTGRES_USER=pakit
POSTGRES_PASSWORD=
